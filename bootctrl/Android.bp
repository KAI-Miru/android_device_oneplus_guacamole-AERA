// Official TeamWin Qualcomm bootctrl and OnePlus SM8150 GPT sources.
// Guacamole is physical A/B, so no dynamic-partition load hook is needed.
cc_library_shared {
    name: "bootctrl.msmnile",
    vendor: true,
    recovery_available: true,
    relative_install_path: "hw",
    srcs: ["boot_control.cpp", "gpt-utils.cpp"],
    header_libs: ["libhardware_headers", "libsystem_headers"],
    shared_libs: ["libcutils", "liblog", "libz"],
    cflags: ["-Wall", "-Werror", "-D_GENERIC_KERNEL_HEADERS"],
}
